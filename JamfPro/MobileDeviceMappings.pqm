[
    ApiFields = (mappings as list) as list => List.Transform(mappings, each _[api]),
    TableFields = (mappings as list) as list => List.Transform(mappings, each _[mapped]),

    GeneralFields = {
        [api = "displayName",                                 mapped = "name"],
        [api = "udid",                                        mapped = "mobileDeviceDetails.udid"],
        [api = "assetTag",                                    mapped = "mobileDeviceDetails.asset_tag"],
        [api = "siteId",                                      mapped = "mobileDeviceDetails.site_id"],
        [api = "lastInventoryUpdateDate",                     mapped = "mobileDeviceDetails.last_inventory_update_utc"],
        [api = "lastContactDate",                             mapped = "mobileDeviceDetails.last_contact_utc"],
        [api = "osVersion",                                   mapped = "mobileDeviceDetails.os_version"],
        [api = "osRapidSecurityResponse",                     mapped = "mobileDeviceDetails.os_rapid_security_response"],
        [api = "osBuild",                                     mapped = "mobileDeviceDetails.os_build"],
        [api = "osSupplementalBuildVersion",                  mapped = "mobileDeviceDetails.os_supplemental_build_version"],
        [api = "softwareUpdateDeviceId",                      mapped = "mobileDeviceDetails.software_update_device_id"],
        [api = "ipAddress",                                   mapped = "mobileDeviceDetails.ip_address"],
        [api = "managed",                                     mapped = "mobileDeviceDetails.managed"],
        [api = "supervised",                                  mapped = "mobileDeviceDetails.supervised"],
        [api = "deviceOwnershipType",                         mapped = "mobileDeviceDetails.device_ownership_type"],
        [api = "enrollmentSessionTokenValid",                 mapped = "mobileDeviceDetails.enrollment_session_token_valid"],
        [api = "lastEnrolledDate",                            mapped = "mobileDeviceDetails.last_enrolled_date_utc"],
        [api = "mdmProfileExpirationDate",                    mapped = "mobileDeviceDetails.mdm_profile_expiration_date_utc"],
        [api = "timeZone",                                    mapped = "mobileDeviceDetails.time_zone"],
        [api = "declarativeDeviceManagementEnabled",          mapped = "mobileDeviceDetails.declarative_device_management_enabled"],
        [api = "managementId",                                mapped = "mobileDeviceDetails.management_id"],
        [api = "lastLoggedInUsernameSelfService",             mapped = "mobileDeviceDetails.last_logged_in_username_self_service"],
        [api = "lastLoggedInUsernameSelfServiceTimestamp",    mapped = "mobileDeviceDetails.last_logged_in_username_self_service_timestamp_utc"],
        [api = "lastLoggedInUsernameMdm",                     mapped = "mobileDeviceDetails.last_logged_in_username_mdm"],
        [api = "lastLoggedInUsernameMdmTimestamp",            mapped = "mobileDeviceDetails.last_logged_in_username_mdm_timestamp_utc"],
        [api = "sharedIpad",                                  mapped = "mobileDeviceDetails.shared_ipad"],
        [api = "diagnosticAndUsageReportingEnabled",          mapped = "mobileDeviceDetails.diagnostic_and_usage_reporting_enabled"],
        [api = "appAnalyticsEnabled",                         mapped = "mobileDeviceDetails.app_analytics_enabled"],
        [api = "residentUsers",                               mapped = "mobileDeviceDetails.resident_users"],
        [api = "quotaSize",                                   mapped = "mobileDeviceDetails.quota_size"],
        [api = "temporarySessionOnly",                        mapped = "mobileDeviceDetails.temporary_session_only"],
        [api = "temporarySessionTimeout",                     mapped = "mobileDeviceDetails.temporary_session_timeout"],
        [api = "userSessionTimeout",                          mapped = "mobileDeviceDetails.user_session_timeout"],
        [api = "syncedToComputer",                            mapped = "mobileDeviceDetails.synced_to_computer"],
        [api = "maximumSharediPadUsersStored",                mapped = "mobileDeviceDetails.maximum_shared_ipad_users_stored"],
        [api = "lastBackupDate",                              mapped = "mobileDeviceDetails.last_backup_date_utc"],
        [api = "deviceLocatorServiceEnabled",                 mapped = "mobileDeviceDetails.device_locator_service_enabled"],
        [api = "doNotDisturbEnabled",                         mapped = "mobileDeviceDetails.do_not_disturb_enabled"],
        [api = "cloudBackupEnabled",                          mapped = "mobileDeviceDetails.cloud_backup_enabled"],
        [api = "lastCloudBackupDate",                         mapped = "mobileDeviceDetails.last_cloud_backup_date_utc"],
        [api = "locationServicesForSelfServiceMobileEnabled", mapped = "mobileDeviceDetails.location_services_for_self_service_mobile_enabled"],
        [api = "itunesStoreAccountActive",                    mapped = "mobileDeviceDetails.itunes_store_account_is_active"],
        [api = "exchangeDeviceId",                            mapped = "mobileDeviceDetails.exchange_device_id"],
        [api = "tethered",                                    mapped = "mobileDeviceDetails.tethered"],
        [api = "airPlayPassword",                             mapped = "mobileDeviceDetails.airplay_password"],
        [api = "locales",                                     mapped = "mobileDeviceDetails.locales"],
        [api = "languages",                                   mapped = "mobileDeviceDetails.languages"]
    },

    HardwareFields = {
        [api = "capacityMb",                                  mapped = "mobileDeviceDetails.capacity_mb"],
        [api = "availableSpaceMb",                            mapped = "mobileDeviceDetails.available_space_mb"],
        [api = "usedSpacePercentage",                         mapped = "mobileDeviceDetails.used_space_percentage"],
        [api = "batteryLevel",                                mapped = "mobileDeviceDetails.battery_level"],
        [api = "batteryHealth",                               mapped = "mobileDeviceDetails.battery_health"],
        [api = "serialNumber",                                mapped = "mobileDeviceDetails.serial_number"],
