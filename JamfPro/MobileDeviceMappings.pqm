        [api = "homeMobileCountryCode",                       mapped = "mobileDeviceDetails.home_mobile_country_code"],
        [api = "homeMobileNetworkCode",                       mapped = "mobileDeviceDetails.home_mobile_network_code"],
        [api = "dataRoamingEnabled",                          mapped = "mobileDeviceDetails.data_roaming_enabled"],
        [api = "roaming",                                     mapped = "mobileDeviceDetails.roaming"],
        [api = "personalHotspotEnabled",                      mapped = "mobileDeviceDetails.personal_hotspot_enabled"],
        [api = "phoneNumber",                                 mapped = "mobileDeviceDetails.cellular_phone_number"],
        [api = "preferredVoiceNumber",                        mapped = "mobileDeviceDetails.preferred_voice_number"]
    },

    FieldsToDuplicate = {
        [original = "mobileDeviceDetails.realname",              duplicate = "mobileDeviceDetails.real_name"],
        [original = "mobileDeviceDetails.warranty_expires_utc",  duplicate = "mobileDeviceDetails.warranty_expires"],
        [original = "mobileDeviceDetails.lease_expires_utc",     duplicate = "mobileDeviceDetails.lease_expires"],
        [original = "mobileDeviceDetails.po_date_utc",           duplicate = "mobileDeviceDetails.po_date"],
        [original = "mobileDeviceDetails.last_contact_utc",      duplicate = "mobileDeviceDetails.last_contact_time"],
        [original = "mobileDeviceDetails.capacity_mb",           duplicate = "mobileDeviceDetails.capacity"],
        [original = "mobileDeviceDetails.available_space_mb",    duplicate = "mobileDeviceDetails.available_space"]
    },

    AppsAndEAsFieldsToDuplicate = {
        [original = "model_identifier",                          duplicate = "modelIdentifier"]
    },

    AdditionalSectionJsonFields = {
        [source = "applications",           mapped = "mobileDeviceDetails.applications_json"],
        [source = "ebooks",                 mapped = "mobileDeviceDetails.ebooks_json"],
        [source = "serviceSubscriptions",   mapped = "mobileDeviceDetails.service_subscriptions_json"],
        [source = "certificates",           mapped = "mobileDeviceDetails.certificates_json"],
        [source = "profiles",               mapped = "mobileDeviceDetails.profiles_json"],
        [source = "userProfiles",           mapped = "mobileDeviceDetails.user_profiles_json"],
        [source = "provisioningProfiles",   mapped = "mobileDeviceDetails.provisioning_profiles_json"],
        [source = "sharedUsers",            mapped = "mobileDeviceDetails.shared_users_json"],
        [source = "groups",                 mapped = "mobileDeviceDetails.groups_json"]
    },

    General =          [api = ApiFields(GeneralFields),          mapped = TableFields(GeneralFields)],
    Hardware =         [api = ApiFields(HardwareFields),         mapped = TableFields(HardwareFields)],
    UserAndLocation =  [api = ApiFields(UserAndLocationFields),  mapped = TableFields(UserAndLocationFields)],
    Security =         [api = ApiFields(SecurityFields),         mapped = TableFields(SecurityFields)],
    LostModeLocation = [api = ApiFields(LostModeLocationFields), mapped = TableFields(LostModeLocationFields)],
    Purchasing =       [api = ApiFields(PurchasingFields),       mapped = TableFields(PurchasingFields)],
    Network =          [api = ApiFields(NetworkFields),          mapped = TableFields(NetworkFields)],

    /**
    * UTC date/time fields mapped directly and converted to `_epoch` columns
    * for backwards compatibility with the legacy model.
    */
    UtcColumnNames = {
        "mobileDeviceDetails.last_inventory_update_utc",
        "mobileDeviceDetails.last_contact_utc",
        "mobileDeviceDetails.last_enrolled_date_utc",
        "mobileDeviceDetails.mdm_profile_expiration_date_utc",
        "mobileDeviceDetails.last_logged_in_username_self_service_timestamp_utc",
        "mobileDeviceDetails.last_logged_in_username_mdm_timestamp_utc",
        "mobileDeviceDetails.last_backup_date_utc",
        "mobileDeviceDetails.last_cloud_backup_date_utc",
        "mobileDeviceDetails.last_attestation_attempt_date_utc",
        "mobileDeviceDetails.last_successful_attestation_date_utc",
        "mobileDeviceDetails.lost_mode_location.last_location_update_utc",
        "mobileDeviceDetails.lost_mode_location.timestamp_utc",
        "mobileDeviceDetails.po_date_utc",
        "mobileDeviceDetails.warranty_expires_utc",
        "mobileDeviceDetails.lease_expires_utc"
    },

    /**
    * Fields retained for backwards compatibility with legacy visualisations.
    */
    UnmappedFields = {
        "mobileDeviceDetails.battery_capacity",
        "mobileDeviceDetails.carrier_network",
        "mobileDeviceDetails.languages_iso",
        "mobileDeviceDetails.locales_iso"
    }
]
