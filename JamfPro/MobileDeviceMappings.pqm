    LostModeLocationFields = {
        [api = "lastLocationUpdate",                          mapped = "mobileDeviceDetails.lost_mode_location.last_location_update_utc"],
        [api = "lostModeLocationHorizontalAccuracyMeters",    mapped = "mobileDeviceDetails.lost_mode_location.horizontal_accuracy_meters"],
        [api = "lostModeLocationVerticalAccuracyMeters",      mapped = "mobileDeviceDetails.lost_mode_location.vertical_accuracy_meters"],
        [api = "lostModeLocationAltitudeMeters",              mapped = "mobileDeviceDetails.lost_mode_location.altitude_meters"],
        [api = "lostModeLocationSpeedMetersPerSecond",        mapped = "mobileDeviceDetails.lost_mode_location.speed_meters_per_second"],
        [api = "lostModeLocationCourseDegrees",               mapped = "mobileDeviceDetails.lost_mode_location.course_degrees"],
        [api = "lostModeLocationTimestamp",                   mapped = "mobileDeviceDetails.lost_mode_location.timestamp_utc"]
    },

    PurchasingFields = {
        [api = "purchased",                                   mapped = "mobileDeviceDetails.is_purchased"],
        [api = "leased",                                      mapped = "mobileDeviceDetails.is_leased"],
        [api = "poNumber",                                    mapped = "mobileDeviceDetails.po_number"],
        [api = "vendor",                                      mapped = "mobileDeviceDetails.vendor"],
        [api = "appleCareId",                                 mapped = "mobileDeviceDetails.applecare_id"],
        [api = "purchasePrice",                               mapped = "mobileDeviceDetails.purchase_price"],
        [api = "purchasingAccount",                           mapped = "mobileDeviceDetails.purchasing_account"],
        [api = "purchasingContact",                           mapped = "mobileDeviceDetails.purchasing_contact"],
        [api = "lifeExpectancy",                              mapped = "mobileDeviceDetails.life_expectancy"],
        [api = "poDate",                                      mapped = "mobileDeviceDetails.po_date_utc"],
        [api = "warrantyExpiresDate",                         mapped = "mobileDeviceDetails.warranty_expires_utc"],
        [api = "leaseExpiresDate",                            mapped = "mobileDeviceDetails.lease_expires_utc"]
