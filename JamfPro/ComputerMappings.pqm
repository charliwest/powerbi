[
    ApiFields = (mappings as list) as list => List.Transform(mappings, each _[api]),
    TableFields = (mappings as list) as list => List.Transform(mappings, each _[mapped]),

    GeneralFields = {
        [api = "name",                                     mapped = "name"],
        [api = "lastIpAddress",                            mapped = "computerDetails.ip_address"],
        [api = "lastReportedIp",                           mapped = "computerDetails.last_reported_ip"],
        [api = "lastReportedIpV4",                         mapped = "computerDetails.last_reported_ipv4"],
        [api = "lastReportedIpV6",                         mapped = "computerDetails.last_reported_ipv6"],
        [api = "jamfBinaryVersion",                        mapped = "computerDetails.jamf_version"],
        [api = "platform",                                 mapped = "computerDetails.platform"],
        [api = "barcode1",                                 mapped = "computerDetails.barcode_1"],
        [api = "barcode2",                                 mapped = "computerDetails.barcode_2"],
        [api = "assetTag",                                 mapped = "computerDetails.asset_tag"],
        [api = "remoteManagement",                         mapped = "remoteManagement"],
        [api = "supervised",                               mapped = "computerDetails.supervised"],
        [api = "mdmCapable",                               mapped = "mdmCapable"],
        [api = "reportDate",                               mapped = "computerDetails.report_date_utc"],
        [api = "lastContactTime",                          mapped = "computerDetails.last_contact_time_utc"],
        [api = "lastCheckIn",                              mapped = "computerDetails.last_check_in_utc"],
        [api = "lastContact",                              mapped = "computerDetails.last_contact_utc"],
        [api = "lastCloudBackupDate",                      mapped = "computerDetails.last_cloud_backup_date_utc"],
        [api = "lastEnrolledDate",                         mapped = "computerDetails.last_enrolled_date_utc"],
        [api = "mdmProfileExpiration",                     mapped = "computerDetails.mdm_profile_expiration_utc"],
        [api = "initialEntryDate",                         mapped = "computerDetails.initial_entry_date_utc"],
        [api = "distributionPoint",                        mapped = "computerDetails.distribution_point"],
        [api = "site",                                     mapped = "site"],
        [api = "itunesStoreAccountActive",                 mapped = "computerDetails.itunes_store_account_is_active"],
        [api = "enrolledViaAutomatedDeviceEnrollment",     mapped = "computerDetails.enrolled_via_automated_device_enrollment"],
        [api = "userApprovedMdm",                          mapped = "computerDetails.user_approved_mdm"],
        [api = "enrollmentMethod",                         mapped = "enrollmentMethod"],
        [api = "declarativeDeviceManagementEnabled",       mapped = "computerDetails.declarative_device_management_enabled"],
        [api = "managementId",                             mapped = "computerDetails.management_id"],
        [api = "lastLoggedInUsernameSelfService",          mapped = "computerDetails.last_logged_in_username_self_service"],
        [api = "lastLoggedInUsernameSelfServiceTimestamp", mapped = "computerDetails.last_logged_in_username_self_service_timestamp_utc"],
        [api = "lastLoggedInUsernameBinary",               mapped = "computerDetails.last_logged_in_username_binary"],
        [api = "lastLoggedInUsernameBinaryTimestamp",      mapped = "computerDetails.last_logged_in_username_binary_timestamp_utc"],
        [api = "lastLoggedInUsernameMdm",                  mapped = "computerDetails.last_logged_in_username_mdm"],
        [api = "lastLoggedInUsernameMdmTimestamp",         mapped = "computerDetails.last_logged_in_username_mdm_timestamp_utc"]
    },

    SiteFields = {
        [api = "id",                                       mapped = "computerDetails.site.id"],
        [api = "name",                                     mapped = "computerDetails.site.name"]
    },

    EnrollmentMethodFields = {
        [api = "id",                                       mapped = "computerDetails.enrollment_method.id"],
