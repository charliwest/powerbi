        [original = "computerDetails.processor_speed_mhz",      duplicate = "computerDetails.processor_speed"],
        [original = "computerDetails.bus_speed_mhz",            duplicate = "computerDetails.bus_speed"],
        [original = "computerDetails.initial_entry_date_utc",   duplicate = "computerDetails.initial_entry_date"]
    },

    AdditionalSectionJsonFields = {
        [source = "applications",            mapped = "computerDetails.applications_json"],
        [source = "storage",                 mapped = "computerDetails.storage_json"],
        [source = "configurationProfiles",   mapped = "computerDetails.configuration_profiles_json"],
        [source = "printers",                mapped = "computerDetails.printers_json"],
        [source = "services",                mapped = "computerDetails.services_json"],
        [source = "localUserAccounts",       mapped = "computerDetails.local_user_accounts_json"],
        [source = "certificates",            mapped = "computerDetails.certificates_json"],
        [source = "attachments",             mapped = "computerDetails.attachments_json"],
        [source = "packageReceipts",         mapped = "computerDetails.package_receipts_json"],
        [source = "licensedSoftware",        mapped = "computerDetails.licensed_software_json"],
        [source = "ibeacons",                mapped = "computerDetails.ibeacons_json"],
        [source = "softwareUpdates",         mapped = "computerDetails.software_updates_json"],
        [source = "contentCaching",          mapped = "computerDetails.content_caching_json"],
        [source = "groupMemberships",        mapped = "computerDetails.group_memberships_json"]
    },

    General =           [api = ApiFields(GeneralFields),            mapped = TableFields(GeneralFields)],
    Site =              [api = ApiFields(SiteFields),               mapped = TableFields(SiteFields)],
    EnrollmentMethod =  [api = ApiFields(EnrollmentMethodFields),   mapped = TableFields(EnrollmentMethodFields)],
    RemoteManagement =  [api = ApiFields(RemoteManagementFields),   mapped = TableFields(RemoteManagementFields)],
    MdmCapable =        [api = ApiFields(MdmCapableFields),         mapped = TableFields(MdmCapableFields)],
    Purchasing =        [api = ApiFields(PurchasingFields),         mapped = TableFields(PurchasingFields)],
    UserAndLocation =   [api = ApiFields(UserAndLocationFields),    mapped = TableFields(UserAndLocationFields)],
    Hardware =          [api = ApiFields(HardwareFields),           mapped = TableFields(HardwareFields)],
    Security =          [api = ApiFields(SecurityFields),           mapped = TableFields(SecurityFields)],
    OperatingSystem =   [api = ApiFields(OperatingSystemFields),    mapped = TableFields(OperatingSystemFields)],
    DiskEncryption =    [api = ApiFields(DiskEncryptionFields),     mapped = TableFields(DiskEncryptionFields)],

    /**
    * UTC date/time fields mapped directly and converted to `_epoch` numeric milliseconds.
    */
    UtcColumnNames = {
        "computerDetails.report_date_utc",
        "computerDetails.last_contact_time_utc",
        "computerDetails.last_check_in_utc",
        "computerDetails.last_contact_utc",
