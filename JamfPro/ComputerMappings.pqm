        [api = "firewallEnabled",                          mapped = "computerDetails.firewall_enabled"],
        [api = "lastAttestationAttempt",                   mapped = "computerDetails.last_attestation_attempt_utc"],
        [api = "lastSuccessfulAttestation",                mapped = "computerDetails.last_successful_attestation_utc"],
        [api = "attestationStatus",                        mapped = "computerDetails.attestation_status"]
