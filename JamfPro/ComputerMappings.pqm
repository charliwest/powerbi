    DiskEncryptionFields = {
        [api = "individualRecoveryKeyValidityStatus",      mapped = "computerDetails.disk_encryption.individual_recovery_key_validity_status"],
        [api = "institutionalRecoveryKeyPresent",          mapped = "computerDetails.disk_encryption.institutional_recovery_key_present"],
